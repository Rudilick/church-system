PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/church_db
FRONTEND_URL=https://sae-gim.com

# ── Google OAuth + JWT (필수) ─────────────────────────────────
# Google Cloud Console > OAuth 2.0 클라이언트 ID 복사
GOOGLE_CLIENT_ID=your_google_client_id_here

# 강력한 랜덤 문자열 (openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# ── 솔라피 SMS + 카카오 알림톡 (solapi.com) ───────────────────────
# 솔라피 콘솔 > API Key 관리에서 발급
SOLAPI_API_KEY=your_solapi_api_key
SOLAPI_API_SECRET=your_solapi_api_secret
# 솔라피에 사전 등록된 발신번호 (SMS 발신 + 알림톡 실패 시 SMS 대체발송에 사용, 예: 0212345678)
SOLAPI_SENDER=0212345678
# 카카오 채널을 솔라피에 연동한 뒤 발급되는 발신프로필 키 (pfId)
SOLAPI_KAKAO_PF_ID=your_kakao_pfid

UPLOAD_DIR=./uploads
