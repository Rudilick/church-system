PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/church_db
FRONTEND_URL=https://sae-gim.com

# ── Google OAuth + JWT (필수) ─────────────────────────────────
# Google Cloud Console > OAuth 2.0 클라이언트 ID 복사
GOOGLE_CLIENT_ID=your_google_client_id_here

# 강력한 랜덤 문자열 (openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# ── 문자나라 SMS (munjanara.co.kr) ───────────────────────────────
# 문자나라 로그인 ID
MUNJANARA_USER_ID=your_munjanara_id
# 문자나라 로그인 비밀번호
MUNJANARA_PASSWD=your_munjanara_password
# 문자나라에 사전 등록된 발신번호 (예: 02-1234-5678)
MUNJANARA_SENDER=02-0000-0000

UPLOAD_DIR=./uploads
